{
  "name": "bha-cst",
  "version": "1.0.0",
  "description": "Customer Service Twin - Multi-tenant conversation engine",
  "type": "module",
  "main": "engine/src/server.ts",
  "scripts": {
    "build": "tsc -b engine/tsconfig.json && node scripts/copy_web_assets.js",
    "build:engine": "tsc -b engine/tsconfig.json",
    "copy:web": "node scripts/copy_web_assets.js",
    "start": "node dist/engine/src/server.js",
    "start:dev": "tsx watch engine/src/server.ts",
    "dev": "tsx watch engine/src/server.ts",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "typecheck": "tsc --noEmit -p engine/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose",
    "test:ci": "vitest run --reporter=verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "pg": "^8.12.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "follow-redirects": "1.16.1",
    "fast-uri": "3.1.8",
    "qs": "6.16.1",
    "brace-expansion": "5.0.12"
  }
}
