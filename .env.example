# ─────────────────────────────────────────────────────────────────────────────
# bha-cst  Customer Service Twin — .env.example
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# Every value in this file must be present in .env before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Twilio Transport Credentials ──────────────────────────────────────────────
# Obtain from https://console.twilio.com → Account → API Keys & Tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Messaging Service SID bound to your Twilio phone number(s)
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bha_cst

# ─────────────────────────────────────────────────────────────────────────────
# System #1 — vFarm
# To add a second system, add SYSTEM2_* variables and register them in
# engine/src/systems/registry.ts following the same pattern.
# ─────────────────────────────────────────────────────────────────────────────

# Internal system & tenant identifiers (must match DB seed values)
VFARM_SYSTEM_ID=system-vfarm-01
VFARM_TENANT_ID=tenant-vfarm-01

# Display name used in logging and audit ledger entries
VFARM_SYSTEM_NAME=vFarm System #1

# Comma-separated list of E.164 phone numbers owned by this system.
# Inbound SMS to any of these numbers are routed to this tenant.
# Example: +19715885823,+19715885824
VFARM_PHONE_NUMBERS=+1XXXXXXXXXX

# Customer-facing welcome text sent to unknown / first-time senders.
# Edit this value here — do NOT change source code to update the message.
VFARM_ONBOARDING_REPLY=Welcome to vFarm Support! We received your message. A specialist will assist you shortly.

# ── vFarm External API Seams ──────────────────────────────────────────────────
# Full URL of the vFarm Customer Registry identity resolution endpoint.
# CST calls GET <VFARM_RESOLVE_ENDPOINT>?phone=<E164> to map phone → customer_ref.
VFARM_RESOLVE_ENDPOINT=http://localhost:4000/api/v1/customers/resolve

# Service-to-service API key for CST → vFarm resolve calls.
# Generate a dedicated read-only service key in vFarm admin dashboard.
VFARM_RESOLVE_API_KEY=your_vfarm_service_key_here

# ── BHARAG Knowledge RAG & Incidents.v0 ──────────────────────────────────────
# Base URL of the BHARAG API server — no trailing slash.
# Example: http://localhost:5000/api/v0  or  https://bharag.bhavfarm.com/api/v0
BHARAG_API_URL=http://localhost:5000/api/v0

# Workspace-scoped key issued by BHARAG to CST for the vFarm knowledge corpus.
# Used for:
#   - POST /ask              → Knowledge RAG queries (Source 2)
#   - POST /incidents        → Escalation ticket filing (Source 3)
BHARAG_WORKSPACE_KEY=your_bharag_workspace_key_here

# Unified BHARAG Cluster Ask API URL & Key
BHARAG_CLUSTER_URL=https://bharag2.duckdns.org/api/v1/cluster/ask
BHARAG_CLUSTER_KEY=your_bharag_cluster_key_here

# ── Media Server & AWS S3 Bucket Configuration ────────────────────────────────
# Base URL of the vFarm Media Server — no trailing slash.
# CST requests short-lived signed S3 capture URLs for MMS replies (Source 4).
MEDIA_SERVER_URL=https://media.bhavfarm.com

# Direct AWS S3 Bucket URL where camera captures and MMS photo files are stored.
# Twilio fetches MMS image attachments directly from this presigned S3 URL for customer delivery.
S3_MEDIA_BUCKET_URL=https://vfarm-media-captures.s3.us-east-1.amazonaws.com
AWS_S3_BUCKET_NAME=vfarm-media-captures
AWS_REGION=us-east-1

# ── Slack Error Alerting ──────────────────────────────────────────────────────
# Incoming Webhook URL to dispatch system error alerts and reliability notifications.
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL

# ── ElevenLabs Voice Agent & Clone Configuration ──────────────────────────────
# API key from Jason's ElevenLabs account
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Model ID for low-latency voice synthesis
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Default voice ID / Jason's voice clone pointer
ELEVENLABS_VOICE_ID=Hmy97GCI840wuICQesiM
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# System-specific voice pointer for vFarm CS Twin
VFARM_ELEVENLABS_VOICE_ID=Hmy97GCI840wuICQesiM

# ── vFarm Live API (Spec §4 & §6) ─────────────────────────────────────────────
# Base URL of the live vFarm API (OpenAPI spec at this host + /openapi.json).
# When set, VfarmTenantAdapter constructs a VfarmLiveClient using X-Farm-Key auth.
# When unset, adapter falls back to local/mock mode.
VFARM_BASE_URL=https://bhavfarm1.duckdns.org

# Admin Bearer token for farm discovery (GET /api/v1/farms).
# Stored SERVER-SIDE ONLY — never returned to or stored in the browser.
# All farm IDs and details are fetched dynamically from the vFarm API.
#
# FALLBACK ONLY. The adapter authenticates itself via
# POST /api/v1/auth/login using the credentials below, because vFarm has no
# token-refresh endpoint and a 7-day JWT would otherwise need manual weekly
# rotation. This value is used only when no credentials are configured, or when
# the credentials fail — the upstream's own 401 stays the final authority.
VFARM_JWT=your_vfarm_admin_jwt_here

# Admin credentials for programmatic re-authentication via POST /api/v1/auth/login.
# vFarm exposes NO refresh endpoint, so "refresh" means logging in again; the
# adapter does this automatically whenever its cached token is expired. Setting
# these removes the dependency on a manually maintained long-lived JWT.
# Secrets live here / in the deployment secret store only — never in code.
VFARM_ADMIN_EMAIL=admin@vfarm.co
VFARM_ADMIN_PASSWORD=your_admin_password_here

# X-Farm-Key used as direct service credential for device/reading API calls (X-Farm-Key header).
# The adapter mints farm-scoped keys dynamically via POST /api/v1/tokens.
# Set this as a fallback when dynamic token issuance is not available.
VFARM_FARM_KEY=your_vfarm_farm_key_here

# ── Engine Dashboard ─────────────────────────────────────────────────────────
# Canonical cst.event.v1 ingestion endpoint. When both are set, CST publishes
# cst.turn / cst.delivery / cst.conversation fire-and-forget. When they are
# unset the engine logs "Dashboard event publishing is disabled" and continues.
#ENGINE_DASHBOARD_URL=
#ENGINE_DASHBOARD_KEY=

# ── Dynamic Tenant / Project / Farm Configuration ────────────────────────────
# These values seed the in-memory registry when no durable DB is available.
# In production, the real values come from the database (see initFromDb()).
VFARM_TENANT_ID=tenant-vfarm-01
VFARM_TENANT_NAME=vFarm Global
# REAL vFarm organization UUID, discovered from GET /api/v1/organizations.
# It is NOT a CST-invented id: vFarm answers HTTP 422 for any org_id it does
# not own, which silently disables the live membership/farm-grant cross-check.
# Look it up per environment with: GET /api/v1/organizations
VFARM_TENANT_ORG_ID_MAIN=122d8fb6-f4d3-42e9-b0d6-f2f80a6c276d
VFARM_PROJECT_ID_MAIN=proj-vfarm-main
VFARM_PROJECT_NAME_MAIN=vFarm Main Operations
VFARM_SYSTEM_ID=system-vfarm-01
VFARM_SYSTEM_NAME=vFarm System #1
VFARM_ONBOARDING_REPLY=Welcome to vFarm Support! We received your message. A specialist will assist you shortly.
VFARM_PHONE_NUMBERS=+19715885823
VFARM_ELEVENLABS_VOICE_ID=Hmy97GCI840wuICQesiM
VFARM_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
VFARM_ADMIN_PHONE=+15551234567
# NOTE: there are deliberately no VFARM_DEFAULT_FARM_ID / VFARM_DEFAULT_UNIT_ID
# variables. A platform-wide default farm/unit silently authorized every tenant
# against one farm. Farm scope is vFarm-authoritative and comes from the caller's
# live farm grants (GET /api/v1/users/{id}/farm-grants) resolved through the
# tenant adapter; when grants cannot be read, the caller gets farm_ids: [].
VFARM_DEFAULT_FARM_NAME=vFarm Facility
VFARM_DEFAULT_FARM_CODE=VF-01
VFARM_DEFAULT_DEVICE_COUNT=0

# ── CST Admin Panel (in-memory auth fallback) ────────────────────────────────
# Used only when no database pool is available (dev/test mode).
# SHA-256 hash of the admin password — generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('your_password').digest('hex'))"
CST_ADMIN_EMAIL=admin@cst.com
CST_ADMIN_PASSWORD_HASH=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
CST_ADMIN_NAME=CST Super Admin
